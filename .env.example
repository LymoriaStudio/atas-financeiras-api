# Referência das variáveis de ambiente esperadas pela API.
# O .NET não lê arquivos .env automaticamente — isto é só um guia para configurar
# manualmente no painel do Railway (ou em appsettings.*.json localmente).
# Convenção: "Secao:Chave" no appsettings vira "Secao__Chave" (duplo underscore) como env var.

# Postgres (Railway), SqlServer ou MySql — troca de provider é só isso + a connection string,
# nenhum código muda. Exemplos de connection string por provider:
#   Postgres:  Host=SEU_HOST;Port=5432;Database=atas_financeiras;Username=SEU_USER;Password=SUA_SENHA
#   SqlServer: Server=SEU_HOST;Database=atas_financeiras;User Id=SEU_USER;Password=SUA_SENHA;TrustServerCertificate=True
#   MySql:     Server=SEU_HOST;Port=3306;Database=atas_financeiras;Uid=SEU_USER;Pwd=SUA_SENHA
Database__Provider=Postgres

# String de conexão do banco ativo no momento (formato depende do provider acima)
ConnectionStrings__DefaultConnection=Host=SEU_HOST;Port=5432;Database=atas_financeiras;Username=SEU_USER;Password=SUA_SENHA

# JWT — gere um secret aleatório de pelo menos 32 caracteres (ex: openssl rand -base64 48)
Jwt__Secret=TROQUE-ESTE-VALOR-EM-PRODUCAO
Jwt__Issuer=AtasFinanceirasApi
Jwt__Audience=AtasFinanceirasClient
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=7

# Pasta de armazenamento dos arquivos das atas (monte um Volume no Railway apontando pra cá)
FileStorage__BasePath=/app/uploads

# Domínio(s) do front na Vercel que podem chamar a API (um por índice)
Cors__AllowedOrigins__0=https://seu-projeto.vercel.app

# Cria o primeiro usuário Admin automaticamente na inicialização, se ainda não existir
# nenhum usuário com esse e-mail. Sem isso, um banco novo fica sem ninguém que consiga logar
# (só Admin pode criar usuários). Depois do primeiro login, pode remover essas duas variáveis.
Seed__AdminEmail=admin@sbs.com.br
Seed__AdminPassword=TROQUE-ESTA-SENHA
Seed__AdminFullName=Administrador

# Injetada automaticamente pelo Railway — não precisa configurar manualmente
# PORT=8080
